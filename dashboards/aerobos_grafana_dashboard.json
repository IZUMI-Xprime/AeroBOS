      },
      "pluginVersion": "10.4.0",
      "targets": [
        {
          "rawQuery": "SELECT time, MassFlowRate_kg_h FROM \"AeroBOS_DigitalTwin\".\"OpticalGasPlumes\" WHERE CameraId = '${CameraId}' ORDER BY time DESC LIMIT 1"
