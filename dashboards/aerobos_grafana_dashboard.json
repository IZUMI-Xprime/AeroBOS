    {
      "datasource": "Amazon Timestream",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            { "options": { "false": { "color": "green", "text": "NOMINAL (NO LEAK)" }, "true": { "color": "red", "text": "CRITICAL GAS BLOWOUT" } }, "type": "value" }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "pluginVersion": "10.4.0",
      "targets": [
        {
          "rawQuery": "SELECT time, IsAlarmActive FROM \"AeroBOS_DigitalTwin\".\"OpticalGasPlumes\" WHERE CameraId = '${CameraId}' ORDER BY time DESC LIMIT 1"
        }
      ],
      "title": "Leak Alarm Status",
      "type": "stat"
    },
    {
      "datasource": "Amazon Timestream",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1.0 },
              { "color": "red", "value": 10.0 }
            ]
          },
          "unit": "massflow"
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
