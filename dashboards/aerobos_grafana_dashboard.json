      "datasource": "Amazon Timestream",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            { "options": { "OPEN": { "color": "yellow", "text": "OPEN (FLOWING)" }, "IN_TRANSIT": { "color": "orange", "text": "IN TRANSIT" }, "ISOLATED": { "color": "green", "text": "ISOLATED (SAFE)" } }, "type": "value" }
