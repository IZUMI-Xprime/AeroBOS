    },
    {
      "datasource": "Amazon Timestream",
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "linear", "lineWidth": 2 },
          "unit": "m2"
        }
      },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 15 },
      "id": 7,
      "targets": [
        {
          "rawQuery": "SELECT time, PlumeArea_sqm FROM \"AeroBOS_DigitalTwin\".\"OpticalGasPlumes\" WHERE CameraId = '${CameraId}' AND time >= ago(1h) ORDER BY time ASC"
        }
      ],
      "title": "Plume Spatial Area Expansion (m²)",
      "type": "timeseries"
    },
    {
      "datasource": "Amazon Timestream",
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineWidth": 2 },
          "unit": "sigma"
        }
      },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 15 },
      "id": 8,
      "targets": [
        {
          "rawQuery": "SELECT time, PeakRefractiveAnomaly_sigma, 3.0 AS Anomaly_Threshold FROM \"AeroBOS_DigitalTwin\".\"OpticalGasPlumes\" WHERE CameraId = '${CameraId}' AND time >= ago(1h) ORDER BY time ASC"
        }
      ],
      "title": "Refractive Anomaly SNR (3-Sigma Threshold)",
      "type": "timeseries"
    },
    {
      "datasource": "Amazon Timestream",
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineWidth": 2 },
          "unit": "lengthnm"
        }
      },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 15 },
      "id": 9,
      "targets": [
        {
          "rawQuery": "SELECT time, OpticalPathDifference_nm FROM \"AeroBOS_DigitalTwin\".\"OpticalGasPlumes\" WHERE CameraId = '${CameraId}' AND time >= ago(1h) ORDER BY time ASC"
        }
      ],
      "title": "Line-of-Sight Optical Path Difference (nm)",
      "type": "timeseries"
