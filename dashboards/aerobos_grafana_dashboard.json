      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 101,
      "title": "Live Optical Schlieren & Digital Twin Plume Dispersion",
      "type": "row"
    },
    {
      "datasource": "Amazon Timestream",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 20,
            "gradientMode": "opacity",
            "spanNulls": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1.0 }
            ]
          },
          "unit": "kg/h"
        }
      },
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 6 },
      "id": 5,
      "options": {
        "legend": { "calcs": ["max", "mean"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "rawQuery": "SELECT time, MassFlowRate_kg_h, 1.0 AS EPA_Subpart_W_Threshold FROM \"AeroBOS_DigitalTwin\".\"OpticalGasPlumes\" WHERE CameraId = '${CameraId}' AND time >= ago(1h) ORDER BY time ASC"
        }
      ],
      "title": "Methane Leak Rate vs. EPA Compliance Threshold (1.0 kg/h)",
      "type": "timeseries"
    },
    {
      "datasource": "Amazon Timestream",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "points",
            "pointSize": 10
          },
          "unit": "none"
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 6 },
      "id": 6,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "rawQuery": "SELECT time, CentroidX_norm, CentroidY_norm FROM \"AeroBOS_DigitalTwin\".\"OpticalGasPlumes\" WHERE CameraId = '${CameraId}' AND time >= ago(15m) ORDER BY time ASC"
        }
      ],
      "title": "Plume Centroid Spatial Trajectory",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
